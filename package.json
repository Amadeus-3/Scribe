{
  "name": "scribe",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Article Engine (codename Scribe): scheduled SEO article pipeline with a mandatory human approval gate.",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,md,json,yaml,yml}\"",
    "db:generate": "pnpm --filter @scribe/core db:generate",
    "db:migrate": "pnpm --filter @scribe/core db:migrate",
    "db:deploy": "pnpm --filter @scribe/core db:deploy",
    "db:studio": "pnpm --filter @scribe/core db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@sentry/cli",
      "sharp",
      "protobufjs"
    ]
  }
}
