{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@scribe/core",
        "exec",
        "dotenv",
        "-e",
        "../../.env",
        "--",
        "pnpm",
        "--filter",
        "@scribe/web",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "web-fresh",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@scribe/core",
        "exec",
        "dotenv",
        "-e",
        "../../.env.fresh",
        "-e",
        "../../.env",
        "--",
        "pnpm",
        "--filter",
        "@scribe/web",
        "dev"
      ],
      "port": 4000
    }
  ]
}
