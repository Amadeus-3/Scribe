// Scribe / Article Engine — canonical data model (Spec §5).
// All Json columns MUST be validated by a Zod schema before write (Spec §5.1).
// All article state transitions MUST go through transitionArticle() (Spec §5.1).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum CmsType {
  WORDPRESS
  STRAPI
}

enum SiteStatus {
  ACTIVE
  PAUSED
}

enum KeywordStatus {
  QUEUED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum SearchIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

enum BriefStatus {
  GENERATED
  APPROVED
  CONSUMED
  REJECTED
}

enum ArticleStatus {
  QUEUED
  BRIEFED
  BRIEF_APPROVED
  DRAFTING
  DRAFTED
  QA_PASSED
  QA_FAILED
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  REJECTED
  ARCHIVED
}

enum RevisionAuthorType {
  AI
  HUMAN
}

enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  role          Role       @default(VIEWER)
  // Auth.js fields
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime   @default(now())
  reviews       Review[]
  auditLogs     AuditLog[]
}

// ── Auth.js (NextAuth v5) adapter models ─────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id                String      @id @default(cuid())
  name              String
  baseUrl           String
  // Public URL path prefix for published posts, e.g. "/blog" → links resolve to
  // {baseUrl}/blog/{slug}. Null/empty = posts live at the site root ({baseUrl}/{slug}).
  // Used to build correct internal links to existing posts.
  articlePathPrefix String?
  cmsType           CmsType     @default(WORDPRESS)
  // Encrypted at rest (Spec §10.3). Stores ciphertext + iv + tag, never plaintext.
  cmsCredentialsEnc String?
  defaultAuthor     String? // CMS author/username to attribute posts to
  status            SiteStatus  @default(ACTIVE)
  briefAutoApprove  Boolean     @default(true)
  // Google Search Console property id, e.g. "sc-domain:example.com" (non-secret).
  gscPropertyUrl    String?
  // Opt this site into the optional weekly trending-topic discovery cron.
  discoveryEnabled  Boolean     @default(false)
  styleGuide        StyleGuide?
  keywords          Keyword[]
  articles          Article[]
  createdAt         DateTime    @default(now())
}

model StyleGuide {
  id                      String   @id @default(cuid())
  siteId                  String   @unique
  site                    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  systemPrompt            String // the drafting system prompt; cached via prompt caching
  businessContext         String?
  audienceNotes           String?
  seoGuidance             String?
  imagePromptInstructions String?
  toneNotes               String?
  formattingRules         String?
  readingLevel            String? // e.g. "Grade 8"
  bannedPhrases           Json? // string[]
  // Structured niche for trending-topic discovery (validated by SiteTopicsSchema).
  topicPillars            Json? // string[] — primary niche pillars
  topicClusters           Json? // string[] — supporting subtopics
  excludedTopics          Json? // string[] — off-niche / brand-safety deny list
  geo                     String? // ISO country (e.g. "US") for Trends/geo scoping
  updatedAt               DateTime @updatedAt
}

model Keyword {
  id           String        @id @default(cuid())
  siteId       String
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  term         String
  intent       SearchIntent?
  searchVolume Int?
  difficulty   Int?
  priority     Int           @default(0)
  status       KeywordStatus @default(QUEUED)
  // Provenance of how this keyword entered the queue (KeywordSourceId).
  source         String? // e.g. "manual_seed" | "google_search_console" | "google_trends" | "llm_web"
  discoveryScore Float? // 0..1 blended ranking score (distinct from human-set `priority`)
  sourceMetadata Json? // per-source rationale ("why queued"), validated before write
  sourcedAt    DateTime      @default(now())
  brief        Brief?
  article      Article?

  @@unique([siteId, term])
  @@index([siteId, status])
  @@index([siteId, source])
}

model Brief {
  id                  String       @id @default(cuid())
  keywordId           String       @unique
  keyword             Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  title               String
  intent              SearchIntent
  outline             Json // structured: [{ heading, level, points[] }]
  targetWordCount     Int
  internalLinkTargets Json? // [{ url, anchorHint }]
  serpAnalysis        Json? // summarized competitor subtopics, gaps (data only)
  status              BriefStatus  @default(GENERATED)
  approvedById        String?
  createdAt           DateTime     @default(now())
  article             Article?
}

model Article {
  id              String            @id @default(cuid())
  siteId          String
  site            Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keywordId       String            @unique
  keyword         Keyword           @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  briefId         String?           @unique
  brief           Brief?            @relation(fields: [briefId], references: [id])
  title           String?
  slug            String?
  metaDescription String?
  // Reviewer-chosen CMS taxonomy (by slug); resolved to CMS documentIds at publish.
  categorySlug    String?
  tagSlugs        String[] @default([])
  // Hero image: prompt + the single uploaded/generated hero asset.
  imagePrompt     String?
  imageMimeType   String?
  imageDataBase64 String?
  // In-body (supporting) images, each with its own prompt + optional uploaded asset.
  images          ArticleImage[]
  contentMarkdown String? // canonical content
  contentHtml     String? // sanitized render/publish form
  status          ArticleStatus     @default(QUEUED)
  wordCount       Int?
  qaReport        Json? // SeoReport (seo/seo-report.ts): { version, score, verdict, checks[], flags[], wordCount, generatedAt }
  llmModel        String?
  costUsd         Decimal?          @db.Decimal(10, 4)
  regenAttempts   Int               @default(0)
  currentVersion  Int               @default(0)
  revisions       ArticleRevision[]
  reviews         Review[]
  publishRecords  PublishRecord[]
  usageRecords    UsageRecord[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([siteId, status])
}

// In-body / supporting images suggested by the drafter for one article.
// The hero image stays on Article; these are the additional images a longer
// article needs (a chart, a flowchart, a comparison visual, ...), each with a
// placement hint, alt text, aspect ratio, its own prompt, and an optional
// uploaded/generated asset. No autonomous publishing implications (Spec §10.1).
model ArticleImage {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  position    Int // order within the article (0-based)
  placement   String? // where it belongs, e.g. the heading it should follow
  alt         String? // alt text (accessibility + relevance signal)
  prompt      String // detailed manual generation prompt
  aspectRatio String? // e.g. "16:9", "4:3"
  mimeType    String? // set once an image is uploaded/generated
  dataBase64  String? // the asset, base64-encoded; null until provided
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([articleId])
}

model ArticleRevision {
  id              String             @id @default(cuid())
  articleId       String
  article         Article            @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version         Int
  contentMarkdown String
  authorType      RevisionAuthorType
  editedById      String? // user id when authorType = HUMAN
  note            String? // e.g. reviewer change request, or "ai initial draft"
  createdAt       DateTime           @default(now())

  @@unique([articleId, version])
}

model Review {
  id         String         @id @default(cuid())
  articleId  String
  article    Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  decision   ReviewDecision
  reason     String?
  createdAt  DateTime       @default(now())

  @@index([articleId])
}

model PublishRecord {
  id             String    @id @default(cuid())
  articleId      String
  article        Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  cmsPostId      String?
  url            String?
  idempotencyKey String    @unique
  status         String // "success" | "failed"
  error          String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([articleId])
}

model UsageRecord {
  id           String   @id @default(cuid())
  articleId    String?
  article      Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  provider     String   @default("anthropic")
  model        String
  purpose      String // "brief" | "draft_outline" | "draft_section" | "qa" | ...
  inputTokens  Int
  outputTokens Int
  cachedTokens Int      @default(0)
  costUsd      Decimal  @db.Decimal(10, 6)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([articleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // null for system/cron actions
  actor      User?    @relation(fields: [actorId], references: [id])
  actorType  String // "human" | "system"
  action     String // e.g. "article.approved", "site.credentials.updated"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value Json
}

model ProviderCredential {
  provider       String   @id
  credentialsEnc String
  updatedAt      DateTime @updatedAt
}
