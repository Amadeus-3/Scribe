// Scribe / Article Engine — canonical data model (Spec §5).
// All Json columns MUST be validated by a Zod schema before write (Spec §5.1).
// All article state transitions MUST go through transitionArticle() (Spec §5.1).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum CmsType {
  WORDPRESS // extensible
}

enum SiteStatus {
  ACTIVE
  PAUSED
}

enum KeywordStatus {
  QUEUED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum SearchIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

enum BriefStatus {
  GENERATED
  APPROVED
  CONSUMED
  REJECTED
}

enum ArticleStatus {
  QUEUED
  BRIEFED
  BRIEF_APPROVED
  DRAFTING
  DRAFTED
  QA_PASSED
  QA_FAILED
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  REJECTED
  ARCHIVED
}

enum RevisionAuthorType {
  AI
  HUMAN
}

enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  role          Role       @default(VIEWER)
  // Auth.js fields
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime   @default(now())
  reviews       Review[]
  auditLogs     AuditLog[]
}

// ── Auth.js (NextAuth v5) adapter models ─────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id     String  @id @default(cuid())
  name   String
  baseUrl String
  cmsType CmsType @default(WORDPRESS)
  // Encrypted at rest (Spec §10.3). Stores ciphertext + iv + tag, never plaintext.
  cmsCredentialsEnc String?
  defaultAuthor     String? // CMS author/username to attribute posts to
  status            SiteStatus  @default(ACTIVE)
  briefAutoApprove  Boolean     @default(true)
  styleGuide        StyleGuide?
  keywords          Keyword[]
  articles          Article[]
  createdAt         DateTime    @default(now())
}

model StyleGuide {
  id              String   @id @default(cuid())
  siteId          String   @unique
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  systemPrompt    String // the drafting system prompt; cached via prompt caching
  toneNotes       String?
  formattingRules String?
  readingLevel    String? // e.g. "Grade 8"
  bannedPhrases   Json? // string[]
  updatedAt       DateTime @updatedAt
}

model Keyword {
  id           String        @id @default(cuid())
  siteId       String
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  term         String
  intent       SearchIntent?
  searchVolume Int?
  difficulty   Int?
  priority     Int           @default(0)
  status       KeywordStatus @default(QUEUED)
  sourcedAt    DateTime      @default(now())
  brief        Brief?
  article      Article?

  @@unique([siteId, term])
  @@index([siteId, status])
}

model Brief {
  id                  String       @id @default(cuid())
  keywordId           String       @unique
  keyword             Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  title               String
  intent              SearchIntent
  outline             Json // structured: [{ heading, level, points[] }]
  targetWordCount     Int
  internalLinkTargets Json? // [{ url, anchorHint }]
  serpAnalysis        Json? // summarized competitor subtopics, gaps (data only)
  status              BriefStatus  @default(GENERATED)
  approvedById        String?
  createdAt           DateTime     @default(now())
  article             Article?
}

model Article {
  id              String        @id @default(cuid())
  siteId          String
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keywordId       String        @unique
  keyword         Keyword       @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  briefId         String?       @unique
  brief           Brief?        @relation(fields: [briefId], references: [id])
  title           String?
  slug            String?
  metaDescription String?
  contentMarkdown String? // canonical content
  contentHtml     String? // sanitized render/publish form
  status          ArticleStatus @default(QUEUED)
  wordCount       Int?
  qaReport        Json? // { checks: [{ id, pass, detail }], score }
  llmModel        String?
  costUsd         Decimal?      @db.Decimal(10, 4)
  regenAttempts   Int           @default(0)
  currentVersion  Int           @default(0)
  revisions       ArticleRevision[]
  reviews         Review[]
  publishRecords  PublishRecord[]
  usageRecords    UsageRecord[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([siteId, status])
}

model ArticleRevision {
  id              String             @id @default(cuid())
  articleId       String
  article         Article            @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version         Int
  contentMarkdown String
  authorType      RevisionAuthorType
  editedById      String? // user id when authorType = HUMAN
  note            String? // e.g. reviewer change request, or "ai initial draft"
  createdAt       DateTime           @default(now())

  @@unique([articleId, version])
}

model Review {
  id         String         @id @default(cuid())
  articleId  String
  article    Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  decision   ReviewDecision
  reason     String?
  createdAt  DateTime       @default(now())

  @@index([articleId])
}

model PublishRecord {
  id             String    @id @default(cuid())
  articleId      String
  article        Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  cmsPostId      String?
  url            String?
  idempotencyKey String    @unique
  status         String // "success" | "failed"
  error          String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([articleId])
}

model UsageRecord {
  id           String   @id @default(cuid())
  articleId    String?
  article      Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  provider     String   @default("anthropic")
  model        String
  purpose      String // "brief" | "draft_outline" | "draft_section" | "qa" | ...
  inputTokens  Int
  outputTokens Int
  cachedTokens Int      @default(0)
  costUsd      Decimal  @db.Decimal(10, 6)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([articleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // null for system/cron actions
  actor      User?    @relation(fields: [actorId], references: [id])
  actorType  String // "human" | "system"
  action     String // e.g. "article.approved", "site.credentials.updated"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value Json
}
