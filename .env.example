# ─────────────────────────────────────────────────────────────────────────────
# Scribe / Article Engine — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`. (Spec §10.1, §12)
# Validated at startup by packages/core/src/config/env.ts — boot fails fast if a
# required variable is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
# Canonical app URL (used for auth callbacks, magic-link emails, alert links).
APP_BASE_URL=http://localhost:4000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://scribe:scribe@localhost:5434/scribe?schema=public
# Direct (non-pooled) connection used for migrations only.
DIRECT_URL=postgresql://scribe:scribe@localhost:5434/scribe?schema=public

# ── AI providers ─────────────────────────────────────────────────────────────
# Text generation uses OpenRouter. Prefer saving this in Settings > OpenRouter
# API key; this env value remains a fallback for local/dev deployments.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Image generation uses the Gemini API. Prefer saving this in Settings > Gemini
# API key; this env value remains a fallback for local/dev deployments.
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional legacy/direct Anthropic key; OpenRouter is the default text provider.
ANTHROPIC_API_KEY=

# ── Inngest (self-hosted dev server or Inngest Cloud) ────────────────────────
INNGEST_EVENT_KEY=local-event-key
INNGEST_SIGNING_KEY=signkey-local-xxxxxxxxxxxxxxxxxxxxxxxx
# Local dev server URL for OUTBOUND event sends (inngest.send / step.sendEvent).
# Compose publishes the dev server on host 8289 (container 8288), so the SDK's
# dev-mode default of :8288 would post into the void when running on the host.
# Leave unset for Inngest Cloud. Docker Compose overrides this per service.
INNGEST_DEV=http://localhost:8289

# ── Auth.js (NextAuth v5) — email magic link + allowlist (Decision §18.4) ─────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-openssl-rand-base64-32
# Optional. SMTP for magic links, invitations and the review digest. Prefer
# saving it in Settings > Email (stored encrypted); these env values are the
# fallback. Local default points at the compose Mailpit (UI on :8026).
EMAIL_SERVER=smtp://user:password@localhost:2025
EMAIL_FROM="Scribe <no-reply@example.com>"
# Optional. Access is by invitation (Team page); the first email to sign in on
# an empty instance becomes ADMIN. If set, this comma-separated list (a) is
# required for that first sign-in, so an exposed fresh instance cannot be
# claimed by a stranger, and (b) admits listed emails without an invitation.
ALLOWED_SIGNIN_EMAILS=

# ── Encryption (Spec §10.3) ──────────────────────────────────────────────────
# AES-256-GCM key for per-site CMS credentials. MUST be 32 bytes, base64-encoded.
# Generate with: openssl rand -base64 32
# MUST be distinct from AUTH_SECRET and every other secret.
ENCRYPTION_KEY=change-me-distinct-openssl-rand-base64-32

# ── Observability ────────────────────────────────────────────────────────────
# Optional; error tracking disabled if unset.
SENTRY_DSN=
# Optional; Slack/email webhook for budget + failure alerts.
ALERT_WEBHOOK_URL=

# ── Keyword sourcing (Decision §18.1: manual seed only for v1) ───────────────
# Not used in v1 (manual seed list only). Reserved for a future paid provider.
# KEYWORD_API_KEY=
