# Production environment for /opt/scribe/.env on the VPS. Copy, fill, then
# `chmod 600 .env`. Never commit the real file. Validated at boot by
# packages/core/src/config/env.ts; docker-compose.prod.yml also interpolates
# DOMAIN, POSTGRES_PASSWORD, INNGEST_* and IMAGE_TAG from here.

# ── Host ─────────────────────────────────────────────────────────────────────
# Public hostname Caddy serves (A record → this VPS). No scheme, no path.
DOMAIN=scribe.example.com
NODE_ENV=production
# Written by the deploy workflow on each release (the image sha). `latest`
# until the first deploy.
IMAGE_TAG=latest
# Loopback port the host's nginx forwards to (deploy/nginx-scribe.conf).
WEB_BIND_PORT=4010
# Only on a box with NOTHING else on ports 80/443: uncomment to run the bundled
# Caddy (automatic TLS) instead of host nginx.
# COMPOSE_PROFILES=caddy

# ── Database ─────────────────────────────────────────────────────────────────
# openssl rand -base64 24   (no spaces or quotes)
POSTGRES_PASSWORD=change-me
# DATABASE_URL / DIRECT_URL are set by compose from POSTGRES_PASSWORD; do not
# set them here.

# ── AI providers ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Inngest (self-hosted, production mode) ───────────────────────────────────
# Any opaque string; the dashboard + worker send events with it.
#   openssl rand -hex 32
INNGEST_EVENT_KEY=change-me-hex
# MUST be hex (even length). Same value is passed to the server and the SDK.
#   openssl rand -hex 32
INNGEST_SIGNING_KEY=change-me-hex
# Do NOT set INNGEST_DEV here (compose forces it off in production).

# ── Auth.js — email + password, JWT sessions ─────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=change-me
# Optional. The first visit to an empty instance is /setup, where the
# administrator account is created. If the server is public before you get
# there, set this (8+ characters) and /setup will require it.
SETUP_TOKEN=
# Optional. SMTP for invitations, password resets and the review digest. Set it
# here or later from the dashboard (Settings > Email, stored encrypted). Without
# it, invite and reset links are shown on the Team page to send by hand.
# Format: smtp://USER:PASSWORD@HOST:587   (smtps:// for implicit TLS on 465)
#EMAIL_SERVER=smtp://user:password@smtp.example.com:587
#EMAIL_FROM="Scribe <no-reply@scribe.example.com>"

# ── Encryption (CMS credentials at rest, AES-256-GCM) ────────────────────────
# openssl rand -base64 32  — MUST differ from AUTH_SECRET. Losing it makes every
# stored CMS credential unreadable; back it up with the database.
ENCRYPTION_KEY=change-me

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# ── Optional discovery credentials (prefer the Settings UI) ──────────────────
# GSC_SERVICE_ACCOUNT_JSON=
